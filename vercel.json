{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "includeFiles": "data/processed/**,frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(v1/.*|health|docs|openapi.json)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
